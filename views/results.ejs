<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Results</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <div class="container mt-5">
    <h2 class="text-center">Student Results</h2>

    <% if (results.length === 0) { %>
      <p class="text-center mt-4">No results found.</p>
    <% } else { %>
      <% results.forEach((result) => { %>
        <div class="card mt-4">
          <div class="card-body">
            <% if (result.error) { %>
              <h5 class="card-title text-danger">Error for Student ID: <%= result.studentId %></h5>
              <p><%= result.error %></p>
            <% } else { %>
              <h5 class="card-title">Student: <%= result.studentInfo.studentName %> (ID: <%= result.studentId %>)</h5>
              <p>Program: <%= result.studentInfo.programName %></p>
              <p>Department: <%= result.studentInfo.departmentName %></p>
              <p>CGPA: <strong><%= result.cgpa %></strong></p>
            <% } %>
          </div>
        </div>
      <% }); %>
    <% } %>

    <a href="/" class="btn btn-secondary mt-3">Back</a>
  </div>
   <!-- Footer -->
   <footer class="text-center mt-5 py-3 bg-light">
    <p>&copy; <span id="year"></span> Kazi Nayeem</p>
  </footer>

  <script>
    // Set the current year dynamically
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>
</body>

</html>
